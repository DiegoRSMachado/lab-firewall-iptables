<!--
  local_rules.xml  ·  Regras de correlação para FIREWALL_DROP
  Caminho no manager: /var/ossec/etc/rules/local_rules.xml
  IDs >= 100000 = faixa de usuário. Reinicie o manager após editar:
      sudo systemctl restart wazuh-manager
-->

<group name="local,firewall,iptables,">

  <!-- Evento base: um pacote bloqueado. Nível baixo (ruído esperado). -->
  <rule id="100100" level="3">
    <decoded_as>firewall-drop</decoded_as>
    <description>iptables: pacote bloqueado de $(srcip) destino porta $(dstport)</description>
    <group>firewall_drop,</group>
  </rule>

  <!-- Port scan: muitos bloqueios da mesma origem em janela curta (T1046). -->
  <rule id="100101" level="10" frequency="15" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>Possivel port scan: 15+ pacotes bloqueados de $(srcip) em 60s</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>recon,attack,</group>
  </rule>

  <!-- Brute force SSH: tentativas repetidas barradas na porta 22 (T1110). -->
  <rule id="100102" level="12" frequency="6" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <field name="dstport">^22$</field>
    <description>Possivel brute force SSH: tentativas repetidas a porta 22 de $(srcip)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,attack,</group>
  </rule>

</group>
